{
  "expo": {
    "name": "ChaufX Driver",
    "slug": "chaufx-driver",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "@rnmapbox/maps",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ChaufX uses your location while you are online to route nearby requests and support active trip tracking."
        }
      ]
    ],
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ChaufX uses your location while you are online so we can route the nearest customer requests to you.",
        "NSUserNotificationsUsageDescription": "ChaufX uses notifications to alert you about new bookings and trip lifecycle updates."
      },
      "bundleIdentifier": "ca.chaufx.driver",
      "buildNumber": "12"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#081930"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "ca.chaufx.driver",
      "versionCode": 16
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "e2796350-1dfd-4939-9ec7-d09b3e3265f8"
      }
    },
    "owner": "eazzimetech",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/e2796350-1dfd-4939-9ec7-d09b3e3265f8"
    }
  }
}
