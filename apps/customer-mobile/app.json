{
  "expo": {
    "name": "ChaufX Customer",
    "slug": "chaufx-customer",
    "scheme": "ca.chaufx.customer",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ChaufX uses your location to confirm your pickup point and show your trip on the map."
        }
      ]
    ],
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ChaufX uses your location to confirm your pickup point when you choose your current location."
      },
      "bundleIdentifier": "ca.chaufx.customer",
      "buildNumber": "14"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#081930"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "ca.chaufx.customer",
      "versionCode": 17
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "109f6065-72d7-4a22-b1d6-3adae32f848f"
      }
    },
    "owner": "eazzimetech",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/109f6065-72d7-4a22-b1d6-3adae32f848f"
    }
  }
}
